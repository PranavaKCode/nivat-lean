def KumarNivat.FullNivat.{u} : Prop :=
∀ (A : Type u) [Finite A] (c : KumarNivat.Site → A),
  (∃ k n, 0 < k ∧ 0 < n ∧ KumarNivat.complexity c (KumarNivat.rectangle k n) ≤ k * n) →
    ∃ h, h ≠ (0, 0) ∧ ∀ (g : KumarNivat.Site), c (g + h) = c g
theorem KumarNivat.fullNivat_iff_explicit.{u} : KumarNivat.FullNivat ↔
  ∀ (A : Type u) [Finite A] (c : ℤ × ℤ → A),
    (∃ k n, 0 < k ∧ 0 < n ∧ (Set.range fun g u => c (g + ↑u)).ncard ≤ k * n) →
      ∃ h, h ≠ (0, 0) ∧ ∀ (g : ℤ × ℤ), c (g + h) = c g :=
Iff.rfl
